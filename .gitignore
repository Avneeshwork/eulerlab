# Data — never committed. The landing zone is rebuilt from source, not from git.
data/
*.parquet
*.duckdb
*.duckdb.wal

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.kite_session.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
config/contract_notes.json

# Paper PDFs are fetched, not committed. arXiv is a permanent public archive,
# so a megabyte of binary in git buys nothing a single request does not — and
# the large-file guard is right to refuse it. `docs/RESEARCH/papers/fetch.sh`
# is the artifact; the PDFs are its output.
docs/RESEARCH/papers/*.pdf
# Paper-agent drafts wait here for the operator (ADR-084). Approved drafts
# move to hypotheses/ and research/papers/, which are committed.
research/agent_drafts/
# The idea lab's generated cards (ADR-110). A survivor is copied into hypotheses/.
research/lab_ideas/
# Generated from docs/METRICS by tools/render_metrics_handbook.py (make handbook). Never edit or commit.
web/public/handbook.html

# Empty per-day app logs written at start-up; never committed (ADR-161).
logs/
