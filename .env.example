# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# EVERY VALUE IN THIS FILE MUST STAY EMPTY. It is a tracked, committed file.
# A real value here is a secret published to the git remote, and `make verify`
# will fail if one appears - see tests/test_no_secrets.py.

# --- Broker: Zerodha Kite Connect (Sprint 2+) --- CHOSEN, see ADR-004
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# --- Broker: Dhan --- deferred; a possible second feed later (ADR-004, T-018) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Cloud storage: Backblaze B2 (ADR-007) ---
# Create an application key scoped to the landing bucket, write access only.
# Do NOT use the account Master Application Key.
B2_KEY_ID=
B2_APP_KEY=

# --- Alerting: Telegram heartbeat for the options recorder (Sprint 2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
