# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# EVERY VALUE IN THIS FILE MUST STAY EMPTY. It is a tracked, committed file.
# A real value here is a secret published to the git remote, and `make verify`
# will fail if one appears - see tests/test_no_secrets.py.

# --- Broker: Zerodha Kite Connect (Sprint 2+) --- CHOSEN, see ADR-004
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# --- FYERS market data: approved expired single-stock futures research ---
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# --- Broker: Angel One SmartAPI ---
# Account login values used to create an authenticated SmartConnect session.
# ANGEL_TOTP_SECRET is the TOTP seed from SmartAPI setup, not a one-time code.
# Keep every value only in your local, gitignored .env file.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Broker: Dhan --- deferred; a possible second feed later (ADR-004, T-018) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Cloud storage: Backblaze B2 (ADR-007) ---
# Create an application key scoped to the landing bucket, write access only.
# Do NOT use the account Master Application Key.
B2_KEY_ID=
B2_APP_KEY=

# --- Alerting: Telegram heartbeat for the options recorder (Sprint 2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The same bot also reports what deployments do and answers the operator
# (ADR-063). Three switches, each on unless set to 0 in .env:
# EULERLAB_TELEGRAM_SIGNALS (a message when a deployment trades or halts),
# EULERLAB_TELEGRAM_BOT (answering the words in `help`),
# EULERLAB_AUTOUPDATE (rebuilding the panel and paper books unasked).
# A fourth, EULERLAB_TELEGRAM_ASK, set to 0 stops the bot passing plain
# sentences to the assistant (ADR-068); the other words still answer.

# --- Kill switch (Sprint 23) ---
# Deliberately NOT a broker credential. The trading process never loads this
# variable - a test asserts no module but killswitch.py even names it - so the
# system that gets stopped cannot authenticate its own restart.
# Any string of 8+ characters. To clear a tripped switch, set this variable
# in the shell and run: uv run python -m eulerlab.oms.killswitch --reset
KILLSWITCH_TOKEN=

# --- Language models (optional) ---
# Only needed for HOSTED providers. The default provider is `ollama`, which runs
# on this machine and needs no key at all. See config/llm.yaml.
# The model only drafts a strategy spec; it never decides anything, and its
# output is validated by code before it can run.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Paper search for the research agent (ADR-131). All optional and free.
# OpenAlex: raises its allowance from $0.10 to $1 of calls a day. CORE: 1,000
# tokens a day. Semantic Scholar: 1 request a second. Also accepted under
# OPEN_ALEX_API_KEY, CORE_API and Semantic_API.
OPENALEX_API_KEY=
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Claude in the assistant (ADR-088). PAID per use: create a key at
# console.anthropic.com and load credit. Used only when picked in the panel.
ANTHROPIC_API_KEY=
# The in-app assistant uses Groq (ADR-064). It stays off until this is 1, and
# you set it only after turning on Zero Data Retention in the Groq console
# (Settings, Data Controls). See docs/RUNBOOKS/assistant-is-offline.md.
EULERLAB_ASSISTANT_ZDR=

# Financial Modeling Prep - news, quotes, sector performance.
# The free (Basic) plan is 250 calls/day and 500MB per 30 days, end-of-day
# only, five years of history. Its published plan matrix puts "Financial
# Market News" on the paid Starter tier, so the news endpoints may refuse a
# free key - run `make fmp-probe` to find out what a given key actually
# reaches rather than trusting the table.
FMP_API_KEY=

# Quantpedia API (optional) - its catalogue of strategies from papers, used by
# the research and knowledge agents as prior evidence only. Pro accounts; ask
# Quantpedia for a key. HTTP Basic: your Quantpedia username and the key.
# `make quantpedia-sync` lands it under data/landing/quantpedia/.
QUANTPEDIA_USERNAME=
QUANTPEDIA_API_KEY=

# Currents API (optional) - market-wide and geopolitical news for the market
# brief (ADR-134). Free plan: 250 requests a day, 30 days back. Without it the
# brief falls back to Google News RSS (titles only). https://currentsapi.services
CURRENT_NEWS_API=

# --- Where data lives (ADR-163) ---
# Unset: `data` under the repository, as on the operator's Mac. A container or
# server sets it to its mounted volume. Read by `eulerlab.paths`.
EULERLAB_DATA_DIR=

# --- Postgres (ADR-165), optional ---
# Unset: the trial ledger stays a file, as on the Mac. Set it only after
# `make db-migrate` and `make db-import`; a ledger file the database lacks is
# refused, not read as empty. With docker compose, POSTGRES_PASSWORD is the
# database password and the URL is postgresql://eulerlab:<it>@postgres:5432/eulerlab
EULERLAB_DATABASE_URL=
POSTGRES_PASSWORD=

# --- Accounts (ADR-168), optional ---
# Unset or off: no login, every request is the single operator (the Mac).
# on: the API asks every request to log in; needs EULERLAB_DATABASE_URL.
# Create the first owner with `make account ARGS="user EMAIL default owner"`.
# Set EULERLAB_COOKIE_SECURE to 1 once the server is behind HTTPS.
EULERLAB_AUTH=
EULERLAB_COOKIE_SECURE=
# Seals each workspace's own keys (ADR-170). Make one with
# `make account ARGS="secret-key"`. Keep a copy off the server: without it the
# stored keys cannot be opened, and it is not in the backup.
EULERLAB_SECRET_KEY=
